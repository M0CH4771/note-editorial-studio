{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-editorial-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./site/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
