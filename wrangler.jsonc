{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-editorial-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./site/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "DRAFTS",
      "id": "4239166f144a48e58509a5baabd49082"
    }
  ],
  "workflows": [
    {
      "name": "note-editorial-studio-daily-drafts",
      "binding": "DAILY_DRAFTS",
      "class_name": "DailyDraftWorkflow",
      "schedules": ["0 0 * * *"]
    }
  ]
}
